rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pairs/{pair}/desk/{player} {
      allow read: if request.auth != null && pair == 'ZMw53o6D1c9zRUXYhSMyQmLU';
      allow write: if request.auth != null && pair == 'ZMw53o6D1c9zRUXYhSMyQmLU'
                   && player in ['j', 'her']
                   && request.resource.data.keys().size() < 30;
    }
    match /pairs/{pair}/recs/{rec} {
      allow read: if request.auth != null && pair == 'ZMw53o6D1c9zRUXYhSMyQmLU';
      allow create: if request.auth != null && pair == 'ZMw53o6D1c9zRUXYhSMyQmLU'
                    && request.resource.data.keys().hasOnly(['from', 'to', 'url', 'nid', 'title', 'note', 'ts', 'read', 'react'])
                    && request.resource.data.from in ['j', 'her']
                    && request.resource.data.to in ['j', 'her']
                    && request.resource.data.from != request.resource.data.to
                    && request.resource.data.url is string && request.resource.data.url.size() <= 600
                    && request.resource.data.title is string && request.resource.data.title.size() <= 200
                    && request.resource.data.note is string && request.resource.data.note.size() <= 120;
      allow update: if request.auth != null && pair == 'ZMw53o6D1c9zRUXYhSMyQmLU'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'react']);
      allow delete: if request.auth != null && pair == 'ZMw53o6D1c9zRUXYhSMyQmLU';
    }
  }
}
